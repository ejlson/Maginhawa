# ── BUILD-TIME VARIABLES ──
# Copy to .env.local for development. Both are NEXT_PUBLIC_, which means they
# are INLINED INTO THE BUNDLE AT BUILD TIME — a host must set them as BUILD
# variables, not runtime ones. Set only at runtime, they read as undefined and
# the feature silently does not exist.

# Cloudinary cloud name. Unset → next/image falls back to `unoptimized: true`
# and photographs ship at source size. See next.config.mjs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX (Admin → Data Streams →
# your web stream). Unset → no gtag, NO CONSENT BANNER, and the privacy
# notice's cookie section reverts to "this site sets no cookies". Deleting
# this variable is a complete rollback of analytics. See lib/consent.ts.
NEXT_PUBLIC_GA_ID=

# ── MARKETING PIXELS ──
# All three are optional and INDEPENDENT: set one, two or all three. Setting
# any of them turns on the banner's Marketing category and makes the privacy
# notice's advertising section appear. Setting none removes all of it.
#
# ⚠️ ADDING THE FIRST ONE RE-ASKS EVERY VISITOR. Consent is specific to the
# purpose it was given for, so the analytics consent already collected does
# not cover advertising — lib/consent.ts bumps CONSENT_KEY for exactly this.
#
# ⚠️ META ALSO NEEDS A CONTRACT, NOT JUST AN ID. The pixel makes this site a
# joint controller with Meta (CJEU C-40/17). Accept the controller-controller
# addendum in Meta Business Manager before going live; the privacy notice
# already describes the arrangement.

# Google Ads conversion ID, "AW-XXXXXXXXX" (Google Ads → Goals → Conversions
# → your tag). Rides the same gtag.js as GA4 — see components/GoogleTag.tsx.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Meta pixel ID — 15-ish digits (Events Manager → Data sources → your pixel).
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok pixel ID (TikTok Ads Manager → Assets → Events → Web events).
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
