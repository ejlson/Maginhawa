/node_modules
/.next
/out
/build
.DS_Store
*.pem
.env*
# …but the template is documentation, not a secret. See CLOUDINARY.md.
!.env.example

# ⚠️ /public/videos/ IS DELIBERATELY *NOT* IGNORED ANY MORE — IT MUST SHIP.
# It was ignored while the films sat here at capture bitrate (218MB, four of
# them over Cloudflare Pages' 25MB per-file ceiling). That had a consequence
# nobody had spelled out: a host that builds from the repository never had
# the films at all, so every <video> on a deployed build was already pointing
# at a file that was not there.
#
# scripts/compress-media.mjs took the set to 70MB with the largest single
# file at 18.6MB, which is under the ceiling — so they are committed now and
# Cloudflare Pages serves them, free and unmetered. That is the whole reason
# the films are NOT on Cloudinary: see the `kind === "video"` branch in
# lib/media.ts for the shared-quota arithmetic behind the split.
#
# Re-ignoring this directory silently breaks every film on the live site.

# raw camera masters — still ignored, still far too big for git
/assets/videos/

# TS build cache
*.tsbuildinfo

# image source originals (served copies live in /public/images)
/assets/images/

# local Claude Code session state — must never be committed
.agents/
.claude/
skills-lock.json

# probe builds (see distDir in next.config.mjs). The glob is deliberate: every
# NEXT_DIST_DIR a probe run invents is a 120-200MB build output, and eight of
# them once sat untracked-but-unignored, adding ~1.2GB of noise to git status.
/.next-*

# raw camera masters — 616MB of originals that the public/ exports come from
/media-src

# probe screenshots — verification artefacts, regenerated by scripts/shoot-*.mjs
/shots

# throwaway probes. The `.tmp-` prefix is the author saying so; they are written
# to answer one question during one session and are dead the moment it is
# answered. The committed probes are scripts/probe-*.mjs and scripts/shoot-*.mjs.
scripts/.tmp-*

# Lighthouse reports (npm run lighthouse -- <url>)
lighthouse-report.html
